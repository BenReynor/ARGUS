{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ARGUS",
  "version": "1.2.0",
  "identifier": "com.argus.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ARGUS - Discord Bot Controller",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "store": null,
    "log": null,
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMxNUIxQjhGNTZBRUIwQ0EKUldUS3NLNVdqeHRiTVdVU3haTFNTTEVuNW1jWnlmc3BaTDJ3eTRockZob0s0K1JTR0tvU1dONXgK",
      "endpoints": [
        "https://github.com/BenReynor/ARGUS/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
